{
  "name": "adi-festa-controle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "node scripts/check-project.js",
    "test": "node --test tests/*.test.js",
    "test:desktop-browser": "node scripts/audit-desktop-browser.cjs",
    "test:desktop-selling": "node scripts/audit-desktop-selling-v2.cjs",
    "test:desktop-design-system": "node scripts/audit-desktop-design-system.cjs",
    "test:mobile-browser": "node scripts/audit-mobile-products-selling.cjs",
    "test:sales-stability-browser": "node scripts/audit-mobile-products-selling.cjs",
    "test:home-clients-browser": "node scripts/audit-mobile-home-clients.cjs",
    "test:home-cart-v142-browser": "node scripts/audit-home-cart-v142.cjs",
    "test:engagement-browser": "node scripts/audit-mobile-engagement-operations.cjs",
    "test:crm-mobile-browser": "node scripts/audit-crm-mobile-carousel.cjs",
    "test:public-catalog-browser": "node scripts/audit-public-catalog-desktop-v2.cjs",
    "test:financial-browser": "node scripts/audit-financial-accounts-cards-v130.cjs && node scripts/audit-financial-shared-accounts-v131.cjs && node scripts/audit-financial-global-credit-cards-v132.cjs && node scripts/audit-global-financial-resources-v134.cjs",
    "test:financial-resources": "node --test tests/financial-global-resources-v134.test.js && node scripts/audit-global-financial-resources-v134.cjs",
    "test:pwa-branding": "node scripts/audit-veconi-pwa-v133.cjs",
    "test:subscription-browser": "node scripts/audit-subscription-pix.cjs && node scripts/audit-subscription-card-monthly.cjs",
    "test:terminal-payments-browser": "node scripts/audit-terminal-payments-v138.cjs",
    "test:global-spaces": "node --test tests/global-spaces-v1.test.js tests/global-space-persistence-v139.test.js tests/home-spaces-context.test.js",
    "test:global-spaces-browser": "node scripts/audit-global-spaces-v139.cjs",
    "test:global-space-name-browser": "node scripts/audit-global-space-canonical-name-v143.cjs",
    "migrate:global-spaces:dry-run": "node scripts/migrate-global-spaces-v139.cjs",
    "test:mobile-structural": "node scripts/audit-mobile-structural.cjs",
    "test:team-access-browser": "node scripts/audit-team-access-v150.cjs",
    "test:login-recovery-browser": "firebase emulators:exec --only auth --project adi-festa-variations-test \"node scripts/audit-login-recovery-v151.cjs\"",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage --project adi-festa-variations-test \"node --test --test-concurrency=1 tests/emulator/*.rules.test.js\"",
    "test:functions-emulator": "firebase emulators:exec --only firestore,auth,functions --project adi-festa-variations-test \"node tests/emulator/onboarding-functions-smoke.js && node tests/emulator/team-access-functions-smoke.js && node tests/emulator/functions-smoke.js && node tests/emulator/activity-events-functions-smoke.js && node tests/emulator/terminal-payment-functions-smoke.js && node functions/test/pix-billing-emulator.js && node functions/test/card-monthly-emulator.js && node functions/test/billing-state-machine-emulator.js && node functions/test/financial-income-emulator.js && node functions/test/financial-account-delete-emulator.js && node functions/test/financial-credit-card-delete-emulator.js\"",
    "build": "node scripts/check-project.js --build"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0"
  }
}
