rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function validRole(role) {
      return role in ['owner', 'admin', 'manager', 'cashier', 'viewer', 'platform_admin'];
    }
    function activeUser() {
      return profileExists() && userProfile().active == true && validRole(userProfile().role);
    }
    function memberExists(businessId) {
      return signedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }
    function teamMember(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data;
    }
    function activeMember(businessId) {
      return memberExists(businessId) && teamMember(businessId).status == 'active';
    }
    function legacyMember(businessId) {
      return !memberExists(businessId) && activeUser() && userProfile().businessId == businessId;
    }
    function roleForBusiness(businessId) {
      return memberExists(businessId) ? teamMember(businessId).role : userProfile().role;
    }
    function currentBusinessId() {
      return userProfile().businessId;
    }
    function businessExists(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId));
    }
    function activeBusiness(businessId) {
      return businessExists(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.active == true;
    }
    function subscriptionAllowsWrites(businessId) {
      let business = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      let subscription = business.subscription;
      return business.active == true
        && (
          (subscription.planId == 'internal' && subscription.status == 'active')
          || subscription.status == 'active'
          || (subscription.status in ['trial', 'trialing'] && subscription.trialEndsAt > request.time)
          || (
            subscription.status == 'grace_period'
            && (!('gracePeriodEndsAt' in subscription) || subscription.gracePeriodEndsAt > request.time)
          )
        );
    }
    function planAllowsCollection(businessId, collectionName) {
      let subscription = get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription;
      return !(collectionName in [
          'campaigns', 'campaignProgress', 'campaignEvents',
          'campaignRedemptions', 'paymentAllocations', 'rewards', 'charges',
          'customerSubscriptions', 'customerSubscriptionEvents',
          'messageHistory', 'messageTemplates', 'messageSequences',
          'visits', 'catalogOrders'
        ])
        || subscription.planId in ['internal', 'trial', 'professional', 'premium'];
    }
    function belongsToBusiness(businessId) {
      return signedIn()
        && (activeMember(businessId) || legacyMember(businessId))
        && activeBusiness(businessId);
    }
    function isOwner(businessId) {
      return belongsToBusiness(businessId)
        && roleForBusiness(businessId) == 'owner';
    }
    function isAdmin(businessId) {
      return belongsToBusiness(businessId) && roleForBusiness(businessId) in ['owner', 'admin', 'manager'];
    }
    function permissionGranted(businessId, permission) {
      return roleForBusiness(businessId) in ['owner', 'platform_admin']
        || (
          memberExists(businessId)
          && teamMember(businessId).get('permissions', {}).get(permission, false) == true
        )
        || (
          !memberExists(businessId)
          && (
            (userProfile().role in ['admin', 'manager'] && permission != 'exportCRM')
            || userProfile().get('permissions', {}).get(permission, false) == true
            || (permission == 'reports.view' && userProfile().get('permissions', {}).get('viewCRM', false) == true)
            || (permission == 'settings.manage' && userProfile().get('permissions', {}).get('manageOperationSettings', false) == true)
          )
        );
    }
    function hasPermission(businessId, permission) {
      return belongsToBusiness(businessId) && permissionGranted(businessId, permission);
    }
    function canAccessSpace(businessId, spaceId) {
      return belongsToBusiness(businessId)
        && spaceId is string
        && !(spaceId in ['all', 'all_spaces'])
        && (
          !memberExists(businessId)
          || roleForBusiness(businessId) == 'owner'
          || teamMember(businessId).spaceAccess == 'all'
          || (
            teamMember(businessId).allowedSpaceIds is list
            && spaceId in teamMember(businessId).allowedSpaceIds
          )
        );
    }
    function legacyCanWriteCollection(businessId, collectionName) {
      return !memberExists(businessId) && (
        userProfile().role in ['owner', 'admin', 'manager']
        || (
          userProfile().role == 'cashier'
          && collectionName in [
            'clients', 'sales', 'payments', 'balanceEvents',
            'charges', 'messageHistory', 'clientContacts', 'catalogOrders',
            'campaignProgress', 'campaignEvents', 'campaignRedemptions',
            'paymentAllocations', 'customerSubscriptions',
            'customerSubscriptionEvents'
          ]
        )
      );
    }
    function legacySensitiveFieldsAllowed(businessId) {
      return !memberExists(businessId)
        && roleForBusiness(businessId) in ['owner', 'admin', 'manager'];
    }
    function canWriteCollection(businessId, collectionName) {
      return subscriptionAllowsWrites(businessId)
        && planAllowsCollection(businessId, collectionName)
        && (
          (legacyMember(businessId) && activeBusiness(businessId) && legacyCanWriteCollection(businessId, collectionName))
          || (
            activeMember(businessId)
            && activeBusiness(businessId)
            && (
              (collectionName == 'sales' && (permissionGranted(businessId, 'sales.create') || permissionGranted(businessId, 'sales.cancel')))
              || (collectionName in ['products', 'productVariants'] && (permissionGranted(businessId, 'products.edit') || permissionGranted(businessId, 'inventory.adjust') || permissionGranted(businessId, 'sales.create')))
              || (collectionName == 'stockMovements' && (permissionGranted(businessId, 'inventory.adjust') || permissionGranted(businessId, 'sales.create')))
              || (collectionName == 'clients' && (permissionGranted(businessId, 'customers.edit') || permissionGranted(businessId, 'customers.receiveDebt') || permissionGranted(businessId, 'customers.adjustBalance') || permissionGranted(businessId, 'sales.create')))
              || (collectionName == 'payments' && permissionGranted(businessId, 'customers.receiveDebt'))
              || (collectionName == 'balanceAdjustments' && permissionGranted(businessId, 'customers.adjustBalance'))
              || (collectionName in ['balanceEvents', 'processedOperations'] && (permissionGranted(businessId, 'sales.create') || permissionGranted(businessId, 'customers.receiveDebt') || permissionGranted(businessId, 'customers.adjustBalance')))
              || (collectionName in ['campaignProgress', 'campaignEvents', 'campaignRedemptions', 'paymentAllocations', 'customerSubscriptions', 'customerSubscriptionEvents', 'rewards'] && permissionGranted(businessId, 'sales.create'))
              || (collectionName == 'campaigns' && permissionGranted(businessId, 'reports.view'))
              || (collectionName in ['charges', 'messageHistory', 'messageTemplates', 'messageSequences', 'clientContacts', 'catalogOrders'] && permissionGranted(businessId, 'customers.edit'))
              || (collectionName == 'customerSegments' && permissionGranted(businessId, 'reports.view'))
              || (collectionName == 'settings' && permissionGranted(businessId, 'settings.manage'))
              || collectionName == 'syncMetadata'
            )
          )
        );
    }
    function canReadCollection(businessId, collectionName) {
      return (
        (
          legacyMember(businessId)
          && activeBusiness(businessId)
          && (!(collectionName in ['customerMetrics', 'customerMonthlyMetrics', 'customerSegments']) || permissionGranted(businessId, 'reports.view'))
        )
        || (
          activeMember(businessId)
          && activeBusiness(businessId)
          && (
            collectionName == 'settings'
            || (collectionName == 'clients' && permissionGranted(businessId, 'customers.view'))
            || (collectionName in ['products', 'productVariants'] && permissionGranted(businessId, 'products.view'))
            || (collectionName == 'stockMovements' && permissionGranted(businessId, 'inventory.view'))
            || (collectionName == 'sales' && permissionGranted(businessId, 'sales.viewAll'))
            || (collectionName in ['payments', 'balanceAdjustments', 'balanceEvents', 'charges', 'paymentAllocations'] && (permissionGranted(businessId, 'financial.view') || permissionGranted(businessId, 'customers.receiveDebt') || permissionGranted(businessId, 'customers.adjustBalance')))
            || (collectionName in ['campaigns', 'campaignProgress', 'campaignEvents', 'campaignRedemptions', 'rewards', 'customerSubscriptions', 'customerSubscriptionEvents', 'messageHistory', 'messageTemplates', 'messageSequences', 'clientContacts', 'catalogOrders'] && (permissionGranted(businessId, 'sales.create') || permissionGranted(businessId, 'reports.view')))
            || (collectionName in ['customerMetrics', 'customerMonthlyMetrics', 'customerSegments', 'visits'] && permissionGranted(businessId, 'reports.view'))
            || collectionName == 'syncMetadata'
            || (collectionName == 'processedOperations' && (permissionGranted(businessId, 'sales.create') || permissionGranted(businessId, 'inventory.adjust')))
          )
        )
      );
    }
    function canRecordProcessedOperation(businessId) {
      return subscriptionAllowsWrites(businessId)
        && activeBusiness(businessId)
        && (
          (
            legacyMember(businessId)
            && userProfile().role in ['owner', 'admin', 'manager', 'cashier']
          )
          || (
            activeMember(businessId)
            && (
              roleForBusiness(businessId) == 'owner'
              || teamMember(businessId).get('permissions', {}).get('sales.create', false) == true
              || teamMember(businessId).get('permissions', {}).get('inventory.adjust', false) == true
              || teamMember(businessId).get('permissions', {}).get('customers.receiveDebt', false) == true
              || teamMember(businessId).get('permissions', {}).get('customers.adjustBalance', false) == true
            )
          )
        );
    }
    function canCreateGenericDocument(businessId, collectionName, documentId) {
      return canWriteCollection(businessId, collectionName)
        && request.resource.data.businessId == businessId
        && (collectionName != 'customerSegments' || permissionGranted(businessId, 'reports.view'))
        && (collectionName != 'settings' || documentId != 'operation' || permissionGranted(businessId, 'settings.manage'));
    }
    function canUpdateGenericDocument(businessId, collectionName, documentId) {
      return canWriteCollection(businessId, collectionName)
        && (resource.data.businessId == businessId || (businessId == 'adi-festa' && !('businessId' in resource.data)))
        && request.resource.data.businessId == businessId
        && (collectionName != 'customerSegments' || permissionGranted(businessId, 'reports.view'))
        && (collectionName != 'settings' || documentId != 'operation' || permissionGranted(businessId, 'settings.manage'));
    }
    function validSpaceCapabilities(capabilities) {
      return capabilities is map
        && capabilities.keys().hasAll(['finance', 'sales', 'products', 'inventory', 'goals'])
        && capabilities.keys().hasOnly(['finance', 'sales', 'products', 'inventory', 'goals'])
        && capabilities.finance is bool
        && capabilities.sales is bool
        && capabilities.products is bool
        && capabilities.inventory is bool
        && capabilities.goals is bool;
    }
    function hasOperationalSpaceCapabilities(capabilities) {
      return capabilities.sales
        || capabilities.products
        || capabilities.inventory
        || capabilities.goals;
    }
    function validGlobalSpaceFields(space, spaceId) {
      return space.keys().hasAll([
          'id', 'type', 'linkedBusinessId', 'businessId', 'operationalType',
          'active', 'status', 'capabilities', 'isDefault', 'globalSpaceSchemaVersion',
          'ownerUid'
        ])
        && space.id == spaceId
        && space.operationalType in ['unit', 'operation', 'personal', 'other']
        && space.status in ['active', 'archived']
        && space.active is bool
        && (
          (space.status == 'active' && space.active == true)
          || (space.status == 'archived' && space.active == false)
        )
        && space.isDefault is bool
        && space.globalSpaceSchemaVersion == 1
        && validSpaceCapabilities(space.capabilities)
        && (
          space.businessId == null
          || (
            space.businessId is string
            && (ownsActiveBusiness(space.businessId) || belongsToBusiness(space.businessId))
          )
        )
        && (
          space.businessId != null
          || !(space.capabilities.sales || space.capabilities.products || space.capabilities.inventory || space.capabilities.goals)
        )
        && (
          !hasOperationalSpaceCapabilities(space.capabilities)
          || (
            space.businessId is string
            && subscriptionAllowsWrites(space.businessId)
            && (
              ownsActiveBusiness(space.businessId)
              || hasPermission(space.businessId, 'spaces.manage')
            )
          )
        )
        && (!(space.operationalType in ['unit', 'operation']) || space.businessId is string)
        && (space.type != 'business' || space.businessId == space.linkedBusinessId);
    }
    function validOperationalSalesSpace(space, businessId) {
      return (!('active' in space) || space.active == true)
        && (!('status' in space) || space.status == 'active')
        && (
          (space.type == 'business' && space.linkedBusinessId == businessId)
          || (
            space.type in ['personal', 'other']
            && space.globalSpaceSchemaVersion == 1
            && space.businessId == businessId
          )
        )
        && (
          (!('capabilities' in space) && space.type == 'business')
          || (space.capabilities is map && space.capabilities.sales == true)
        );
    }
    function operationalSalesSpaceBelongsToBusiness(spaceId, businessId) {
      return !(spaceId in ['all', 'all_spaces'])
        && spaceId.size() > 0
        && exists(/databases/$(database)/documents/financialSpaces/$(spaceId))
        && validOperationalSalesSpace(
          get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data,
          businessId
        );
    }
    function validProductSpaceIds(spaceIds) {
      return spaceIds.size() <= 50
        && !('all' in spaceIds)
        && !('all_spaces' in spaceIds);
    }
    function validProductItemKind(product) {
      return !('itemKind' in product) || product.itemKind in ['product', 'service'];
    }
    function validProductSpaceScope(product, businessId) {
      return validProductItemKind(product)
        && (
          (!('spaceAccessMode' in product) && !('allowedSpaceIds' in product) && !('defaultSpaceId' in product) && !('spaceScopeVersion' in product))
          || (
            product.spaceAccessMode in ['all_spaces', 'selected_spaces', 'single_space']
            && product.allowedSpaceIds is list
            && validProductSpaceIds(product.allowedSpaceIds)
            && product.spaceScopeVersion == 1
            && (
              (
                product.spaceAccessMode == 'all_spaces'
                && product.allowedSpaceIds.size() == 0
                && product.defaultSpaceId == null
              )
              || (
                product.spaceAccessMode == 'selected_spaces'
                && product.allowedSpaceIds.size() > 0
                && product.defaultSpaceId is string
                && product.defaultSpaceId in product.allowedSpaceIds
                && operationalSalesSpaceBelongsToBusiness(product.defaultSpaceId, businessId)
              )
              || (
                product.spaceAccessMode == 'single_space'
                && product.allowedSpaceIds.size() == 1
                && product.defaultSpaceId is string
                && product.allowedSpaceIds[0] == product.defaultSpaceId
                && operationalSalesSpaceBelongsToBusiness(product.defaultSpaceId, businessId)
              )
            )
          )
        );
    }
    function preservesProductSpaceScope(product, persistedProduct) {
      return !product.diff(persistedProduct).affectedKeys().hasAny([
        'spaceAccessMode', 'allowedSpaceIds', 'defaultSpaceId', 'spaceScopeVersion'
      ]);
    }
    function onlyOperationalProductStockChanged(product, persistedProduct) {
      return product.diff(persistedProduct).affectedKeys().hasOnly([
        'estoqueAtual', 'estoque', 'totalStock', 'hasAvailableStock',
        'updatedAt', 'updatedByUid', 'actorUid', 'actorNameSnapshot',
        'actorRoleSnapshot', 'version'
      ]);
    }
    function onlyOperationalVariantStockChanged(variant, persistedVariant) {
      return variant.diff(persistedVariant).affectedKeys().hasOnly([
        'stock', 'updatedAt', 'updatedByUid', 'actorUid',
        'actorNameSnapshot', 'actorRoleSnapshot', 'version'
      ]);
    }
    function preservesSaleActor(sale, persistedSale) {
      return (
          'actorUid' in persistedSale
          && sale.get('actorUid', '') == persistedSale.actorUid
        )
        || (
          !('actorUid' in persistedSale)
          && sale.get('actorUid', '') == request.auth.uid
        );
    }
    function validSaleSpace(sale, businessId) {
      return sale.spaceId is string
        && sale.spaceId.size() > 0
        && sale.spaceId != 'all_spaces'
        && canAccessSpace(businessId, sale.spaceId)
        && operationalSalesSpaceBelongsToBusiness(sale.spaceId, businessId)
        && (!('financialSpaceId' in sale) || sale.financialSpaceId == sale.spaceId);
    }
    function persistedSpaceBelongsToBusiness(spaceId, businessId) {
      return spaceId is string
        && !(spaceId in ['all', 'all_spaces'])
        && spaceId.size() > 0
        && exists(/databases/$(database)/documents/financialSpaces/$(spaceId))
        && (
          (
            get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.type == 'business'
            && get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.linkedBusinessId == businessId
          )
          || (
            get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.type in ['personal', 'other']
            && get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.globalSpaceSchemaVersion == 1
            && get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.businessId == businessId
          )
        );
    }
    function preservesSaleSpaceAssignment(sale, persistedSale, businessId) {
      return 'spaceId' in sale
        && sale.spaceId == persistedSale.spaceId
        && persistedSpaceBelongsToBusiness(sale.spaceId, businessId)
        && (
          !('financialSpaceId' in sale)
          || sale.financialSpaceId == sale.spaceId
          || (
            'financialSpaceId' in persistedSale
            && sale.financialSpaceId == persistedSale.financialSpaceId
          )
        );
    }
    function financialSpace(spaceId) {
      return get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data;
    }
    function ownsActiveBusiness(businessId) {
      return activeUser()
        && activeBusiness(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    function canReadFinancialSpace(spaceId) {
      let space = financialSpace(spaceId);
      return signedIn() && space.active != false && (
        (
          space.type == 'business'
          && (
            ownsActiveBusiness(space.linkedBusinessId)
            || (canAccessSpace(space.linkedBusinessId, spaceId) && permissionGranted(space.linkedBusinessId, 'financial.view'))
          )
        )
        || (
          space.type in ['personal', 'other']
          && space.ownerUid == request.auth.uid
        )
      );
    }
    function canManageFinancialSpace(spaceId) {
      let space = financialSpace(spaceId);
      return signedIn() && space.active != false && (
        (
          space.type == 'business'
          && (ownsActiveBusiness(space.linkedBusinessId) || canAccessSpace(space.linkedBusinessId, spaceId))
          && subscriptionAllowsWrites(space.linkedBusinessId)
          && (ownsActiveBusiness(space.linkedBusinessId) || permissionGranted(space.linkedBusinessId, 'financial.view'))
        )
        || (
          space.type in ['personal', 'other']
          && space.ownerUid == request.auth.uid
        )
      );
    }
    function creditCardAt(homeSpaceId, cardId) {
      return get(/databases/$(database)/documents/financialSpaces/$(homeSpaceId)/creditCards/$(cardId)).data;
    }
    function financialAccountAt(homeSpaceId, accountId) {
      return get(/databases/$(database)/documents/financialSpaces/$(homeSpaceId)/financialAccounts/$(accountId)).data;
    }
    function validFinancialAccountAccess(account, homeSpaceId) {
      return (
        !('accessMode' in account)
        && account.financialSpaceId == homeSpaceId
      ) || (
        account.accountHomeSpaceId == homeSpaceId
        && account.accessMode in ['all_spaces', 'selected_spaces', 'single_space']
        && account.allowedFinancialSpaceIds is list
        && account.allowedFinancialSpaceIds.size() <= 50
        && account.defaultFinancialSpaceId is string
        && account.defaultFinancialSpaceId.size() > 0
        && (
          (account.accessMode == 'all_spaces' && account.allowedFinancialSpaceIds.size() == 0)
          || (account.accessMode == 'selected_spaces' && account.allowedFinancialSpaceIds.size() > 0)
          || (account.accessMode == 'single_space' && account.allowedFinancialSpaceIds.size() == 1 && account.allowedFinancialSpaceIds[0] == account.defaultFinancialSpaceId)
        )
      );
    }
    function financialAccountAllowsSpace(account, targetSpaceId) {
      let target = financialSpace(targetSpaceId);
      return account.active == true
        && account.ownerUid == target.ownerUid
        && (
          (!('accessMode' in account) && account.financialSpaceId == targetSpaceId)
          || account.accessMode == 'all_spaces'
          || (account.accessMode == 'selected_spaces' && targetSpaceId in account.allowedFinancialSpaceIds)
          || (account.accessMode == 'single_space' && account.defaultFinancialSpaceId == targetSpaceId)
        );
    }
    function validCrossSpaceFinancialAccountUse(targetSpaceId, homeSpaceId, accountId) {
      let account = financialAccountAt(homeSpaceId, accountId);
      return exists(/databases/$(database)/documents/financialSpaces/$(homeSpaceId)/financialAccounts/$(accountId))
        && financialAccountAllowsSpace(account, targetSpaceId)
        && (homeSpaceId == targetSpaceId || request.auth.uid == account.ownerUid);
    }
    function validFinancialEntryAccount(spaceId, entry) {
      return !('financialAccountId' in entry) || entry.financialAccountId == null
        ? true
        : entry.financialAccountId is string
          && (
            'financialAccountHomeSpaceId' in entry
              ? entry.financialAccountHomeSpaceId is string
                && validCrossSpaceFinancialAccountUse(spaceId, entry.financialAccountHomeSpaceId, entry.financialAccountId)
              : exists(/databases/$(database)/documents/financialSpaces/$(spaceId)/financialAccounts/$(entry.financialAccountId))
          );
    }
    function financialAccountScopeUpdateAllowed(before, after, homeSpaceId) {
      return !after.diff(before).affectedKeys().hasAny([
          'accountHomeSpaceId', 'accessMode', 'allowedFinancialSpaceIds', 'defaultFinancialSpaceId', 'active'
        ])
        || (
          request.auth.uid == before.ownerUid
          && validFinancialAccountAccess(after, homeSpaceId)
        );
    }
    function validCreditCardAccess(card, homeSpaceId) {
      return card.cardHomeSpaceId == homeSpaceId
        && card.accessMode in ['all_spaces', 'selected_spaces', 'single_space']
        && card.allowedFinancialSpaceIds is list
        && card.allowedFinancialSpaceIds.size() <= 50
        && card.defaultFinancialSpaceId is string
        && card.defaultFinancialSpaceId.size() > 0
        && (
          (card.accessMode == 'all_spaces' && card.allowedFinancialSpaceIds.size() == 0)
          || (card.accessMode == 'selected_spaces' && card.allowedFinancialSpaceIds.size() > 0)
          || (card.accessMode == 'single_space' && card.allowedFinancialSpaceIds.size() == 1 && card.allowedFinancialSpaceIds[0] == card.defaultFinancialSpaceId)
        );
    }
    function creditCardAllowsSpace(card, targetSpaceId) {
      let target = financialSpace(targetSpaceId);
      return card.active == true
        && card.ownerUid == target.ownerUid
        && (
          (!('accessMode' in card) && card.financialSpaceId == targetSpaceId)
          || card.accessMode == 'all_spaces'
          || (card.accessMode == 'selected_spaces' && targetSpaceId in card.allowedFinancialSpaceIds)
          || (card.accessMode == 'single_space' && card.defaultFinancialSpaceId == targetSpaceId)
        );
    }
    function validCrossSpaceCardUse(targetSpaceId, cardHomeSpaceId, cardId) {
      let card = creditCardAt(cardHomeSpaceId, cardId);
      return exists(/databases/$(database)/documents/financialSpaces/$(cardHomeSpaceId)/creditCards/$(cardId))
        && creditCardAllowsSpace(card, targetSpaceId)
        && (
          cardHomeSpaceId == targetSpaceId
          || request.auth.uid == card.ownerUid
        );
    }
    function validFinancialEntryCreditPayment(spaceId, entry) {
      return !('paymentMethod' in entry)
        || entry.paymentMethod != 'credit_card'
        || (
          entry.status in ['paid', 'reversed']
          && entry.creditCardId is string
          && entry.cardHomeSpaceId is string
          && entry.creditCardInvoiceId is string
          && validCrossSpaceCardUse(spaceId, entry.cardHomeSpaceId, entry.creditCardId)
          && existsAfter(/databases/$(database)/documents/financialSpaces/$(entry.cardHomeSpaceId)/creditCardInvoices/$(entry.creditCardInvoiceId))
          && getAfter(/databases/$(database)/documents/financialSpaces/$(entry.cardHomeSpaceId)/creditCardInvoices/$(entry.creditCardInvoiceId)).data.creditCardId == entry.creditCardId
        );
    }
    function creditCardScopeUpdateAllowed(before, after, homeSpaceId) {
      return !after.diff(before).affectedKeys().hasAny([
          'cardHomeSpaceId', 'accessMode', 'allowedFinancialSpaceIds', 'defaultFinancialSpaceId', 'active'
        ])
        || (
          request.auth.uid == before.ownerUid
          && validCreditCardAccess(after, homeSpaceId)
        );
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // O primeiro perfil é criado apenas pela completeBusinessOnboarding.
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.uid == resource.data.uid
          || (
            resource.data.businessId == 'adi-festa'
            && !('uid' in resource.data)
            && request.resource.data.uid == request.auth.uid
          )
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && request.resource.data.businessId == resource.data.businessId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'migrationVersion', 'migratedAt'
          ])
          || (
            resource.data.businessId == 'adi-festa'
            && get(/databases/$(database)/documents/businesses/adi-festa).data.ownerId == request.auth.uid
          )
        )
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.businessId == 'adi-festa'
            && resource.data.role == 'admin'
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/businesses/adi-festa).data.ownerId == request.auth.uid
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'phone', 'role', 'permissions', 'onboardingCompleted',
          'lastLoginAt', 'migrationVersion', 'migratedAt', 'updatedAt', 'tutorialVersions'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tutorialVersions'])
          || (
            request.resource.data.tutorialVersions is map
            && request.resource.data.tutorialVersions.keys().hasOnly([
              'appIntro', 'financial', 'selling', 'products', 'clients',
              'crm', 'campaigns', 'catalog', 'orders', 'settings'
            ])
            && request.resource.data.tutorialVersions.get('appIntro', 0) is int
            && request.resource.data.tutorialVersions.get('appIntro', 0) >= 0
            && request.resource.data.tutorialVersions.get('appIntro', 0) <= 100
          )
        );
      allow delete: if false;
    }

    // Preferências de visualização são pessoais e contêm somente referências
    // para espaços que serão novamente autorizados pelas regras de cada espaço.
    match /financialViewProfiles/{profileUid} {
      allow read: if signedIn() && request.auth.uid == profileUid;
      allow create, update: if signedIn()
        && request.auth.uid == profileUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.customViews is list
        && request.resource.data.customViews.size() <= 30
        && request.resource.data.favoriteViewIds is list
        && request.resource.data.favoriteViewIds.size() <= 50
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'customViews', 'favoriteViewIds', 'defaultViewId',
          'lastViewId', 'schemaVersion', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /publicCatalogs/{visitToken} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.businessId is string
        && belongsToBusiness(request.resource.data.businessId)
        && subscriptionAllowsWrites(request.resource.data.businessId)
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.subscription.planId in ['internal', 'trial', 'professional', 'premium'];
      allow update: if signedIn()
        && resource.data.businessId == request.resource.data.businessId
        && belongsToBusiness(resource.data.businessId)
        && subscriptionAllowsWrites(resource.data.businessId)
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.subscription.planId in ['internal', 'trial', 'professional', 'premium'];
      allow delete: if false;

      match /orders/{orderId} {
        function catalog() {
          return get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data;
        }
        // Pedidos públicos são validados e gravados exclusivamente pela
        // Cloud Function submitCatalogOrder. O Admin SDK ignora estas regras.
        allow create: if false;
        allow get: if true;
        allow list, update: if signedIn() && belongsToBusiness(catalog().businessId);
        allow delete: if false;
      }

      match /campaignProgress/{phoneHash} {
        allow get: if true;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /phoneIndex/{phoneHash} {
        // A busca por telefone passa pela função com rate limit e resposta uniforme.
        allow get: if false;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /portalProfiles/{clientRefToken} {
        allow get: if true;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /portalSessions/{sessionHash} {
        allow get: if true;
        allow list: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow create: if false;
        allow update: if belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /redemptionRequests/{requestId} {
        allow create: if request.resource.data.id == requestId
          && request.resource.data.status == 'solicitado'
          && request.resource.data.businessId == get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId
          && request.resource.data.visitId == get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.visitId
          && request.resource.data.clientRefToken is string
          && request.resource.data.portalSessionHash is string
          && exists(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash))
          && get(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash)).data.active == true
          && get(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash)).data.clientRefToken == request.resource.data.clientRefToken;
        allow get: if true;
        allow list, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
    }

    match /businesses/{businessId} {
      // Empresas e trials iniciais são provisionados exclusivamente pelo backend.
      allow create: if false;
      allow read: if belongsToBusiness(businessId);
      allow update: if (
        isOwner(businessId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.subscription == resource.data.subscription
          && request.resource.data.limits == resource.data.limits
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'legalName', 'document', 'phone', 'email', 'businessType',
            'city', 'state', 'address', 'receiptName', 'active',
            'onboardingCompleted', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && businessId == 'adi-festa'
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            (
              !('subscription' in resource.data)
              && request.resource.data.subscription.planId == 'internal'
              && request.resource.data.subscription.status == 'active'
            )
            || request.resource.data.subscription == resource.data.subscription
          )
          && (
            !('limits' in resource.data)
            || request.resource.data.limits == resource.data.limits
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'slug', 'onboardingCompleted', 'businessType', 'subscription',
            'limits', 'migrationVersion', 'migratedAt', 'updatedAt'
          ])
        );
      allow delete: if false;

      match /billingCheckoutAttempts/{attemptId} {
        allow read: if isOwner(businessId)
          && resource.data.businessId == businessId
          && resource.data.requestedBy == request.auth.uid;
        allow create, update, delete: if false;
      }
      match /subscriptionIntents/{intentId} {
        allow read: if isOwner(businessId);
        allow create, update, delete: if false;
      }
      match /paymentIntents/{intentId} {
        allow get: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'))
          && resource.data.businessId == businessId;
        allow list: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'));
        allow create, update, delete: if false;

        match /events/{eventId} {
          allow read: if belongsToBusiness(businessId)
            && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'))
            && get(/databases/$(database)/documents/businesses/$(businessId)/paymentIntents/$(intentId)).data.businessId == businessId;
          allow create, update, delete: if false;
        }
      }
      match /paymentTerminals/{terminalId} {
        allow get: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'))
          && resource.data.businessId == businessId;
        allow list: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'));
        allow create, update, delete: if false;
      }
      match /paymentProviderConfigs/{providerId} {
        allow read: if isAdmin(businessId)
          && resource.data.businessId == businessId;
        allow create, update, delete: if false;
      }
      match /paymentReceivables/{receivableId} {
        allow get: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'))
          && resource.data.businessId == businessId;
        allow list: if belongsToBusiness(businessId)
          && (!memberExists(businessId) || permissionGranted(businessId, 'financial.view'));
        allow create, update, delete: if false;
      }
      match /invites/{inviteId} {
        allow read: if isAdmin(businessId);
        allow create: if isOwner(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(businessId);
        allow delete: if false;
      }
      match /auditLogs/{logId} {
        allow read: if isOwner(businessId) || hasPermission(businessId, 'team.view');
        allow create: if belongsToBusiness(businessId)
          && request.resource.data.businessId == businessId;
        allow update, delete: if false;
      }
      match /productVariants/{variantId} {
        function parentProduct(productId) {
          // A criação de um produto variável grava o pai e suas variações na
          // mesma transação offline-first. getAfter também enxerga o produto
          // pai que será criado por essa transação; get enxergava apenas o
          // estado anterior e rejeitava toda a operação com permission-denied.
          return getAfter(/databases/$(database)/documents/businesses/$(businessId)/products/$(productId));
        }
        function validVariant(data) {
          return data.id == variantId
            && data.businessId == businessId
            && data.parentProductId is string
            && data.displayName is string
            && data.attributeValues is map
            && data.price is number
            && data.stock is number
            && data.active is bool
            && data.keys().hasOnly([
              'id', 'businessId', 'ownerId', 'parentProductId',
              'attributeValues', 'displayName', 'displayNameNormalized',
              'searchTokens', 'sku', 'barcode', 'price', 'stock',
              'cost', 'custo', 'minStock', 'active', 'catalogVisible', 'allowNegativeStock',
              'durationValue', 'durationUnit',
              'image', 'imageMode', 'imageUrl', 'imageStoragePath',
              'imageThumbUrl', 'imageThumbStoragePath', 'imageUpdatedAt',
              'imageUploadStatus', 'imageOperationId',
              'createdAt', 'updatedAt', 'updatedByUid', 'actorUid',
              'actorNameSnapshot', 'actorRoleSnapshot', 'schemaVersion', 'version'
            ]);
        }
        allow read: if hasPermission(businessId, 'products.view')
          && (!resource.data.keys().hasAny(['cost', 'custo']) || legacySensitiveFieldsAllowed(businessId) || permissionGranted(businessId, 'cost.view'));
        allow create: if canWriteCollection(businessId, 'productVariants')
          && (!memberExists(businessId) || permissionGranted(businessId, 'products.edit'))
          && validVariant(request.resource.data)
          && (!request.resource.data.keys().hasAny(['cost', 'custo']) || legacySensitiveFieldsAllowed(businessId))
          && parentProduct(request.resource.data.parentProductId).data.businessId == businessId;
        allow update: if canWriteCollection(businessId, 'productVariants')
          && (
            !memberExists(businessId)
            || permissionGranted(businessId, 'products.edit')
            || (
              (permissionGranted(businessId, 'inventory.adjust') || permissionGranted(businessId, 'sales.create'))
              && onlyOperationalVariantStockChanged(request.resource.data, resource.data)
            )
          )
          && validVariant(request.resource.data)
          && (!request.resource.data.keys().hasAny(['cost', 'custo']) || legacySensitiveFieldsAllowed(businessId))
          && request.resource.data.parentProductId == resource.data.parentProductId
          && request.resource.data.businessId == resource.data.businessId;
        allow delete: if false;
      }
      match /processedOperations/{operationId} {
        allow read: if canReadCollection(businessId, 'processedOperations');
        allow create: if canRecordProcessedOperation(businessId)
          && request.resource.data.id == operationId
          && request.resource.data.idempotencyKey == operationId
          && request.resource.data.businessId == businessId
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.status in ['processed', 'recovered_existing']
          && request.resource.data.schemaVersion == 3
          && request.resource.data.keys().hasOnly([
            'id', 'idempotencyKey', 'businessId', 'ownerId', 'status',
            'eventKind', 'processedAt', 'createdAtLocal', 'schemaVersion'
          ]);
        allow update, delete: if false;
      }
      match /campaignEvents/{eventId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'campaignEvents')
          && request.resource.data.id == eventId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.campaignId is string
          && request.resource.data.clientId is string
          && request.resource.data.sourceType in ['sale', 'payment', 'cancellation', 'redemption', 'expiration']
          && request.resource.data.transition in ['earned', 'confirmed', 'reversed', 'redeemed', 'expired'];
        allow update, delete: if false;
      }
      match /campaignRedemptions/{redemptionId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'campaignRedemptions')
          && request.resource.data.id == redemptionId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.campaignId is string
          && request.resource.data.clientId is string
          && request.resource.data.status == 'redeemed';
        allow update, delete: if false;
      }
      match /paymentAllocations/{allocationId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'paymentAllocations')
          && request.resource.data.id == allocationId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.paymentId is string
          && request.resource.data.saleId is string
          && request.resource.data.clientId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update, delete: if false;
      }
      match /customerSubscriptionEvents/{eventId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'customerSubscriptionEvents')
          && request.resource.data.id == eventId
          && request.resource.data.businessId == businessId
          && request.resource.data.subscriptionId is string
          && request.resource.data.clientId is string
          && request.resource.data.productId is string
          && request.resource.data.transition in ['activation', 'renewal', 'paused', 'reactivated', 'expired', 'cancelled', 'sale_reversed', 'price_changed', 'plan_changed'];
        allow update, delete: if false;
      }
      match /members/{memberUid} {
        // O próprio usuário pode ler somente o seu vínculo, inclusive quando
        // desativado, para que a interface explique o bloqueio sem encerrar a
        // sessão do Firebase. O acesso ao restante da empresa continua
        // condicionado a belongsToBusiness/activeMember.
        allow read: if (signedIn() && request.auth.uid == memberUid)
          || (belongsToBusiness(businessId) && hasPermission(businessId, 'team.view'));
        allow create, update, delete: if false;
      }
      match /teamInvites/{inviteId} {
        allow read: if hasPermission(businessId, 'team.view');
        allow create, update, delete: if false;
      }
      match /productFinancials/{productId} {
        allow read: if hasPermission(businessId, 'cost.view');
        allow create, update: if hasPermission(businessId, 'cost.view')
          && request.resource.data.businessId == businessId
          && request.resource.data.productId == productId;
        allow delete: if false;
      }
      match /variantFinancials/{variantId} {
        allow read: if hasPermission(businessId, 'cost.view');
        allow create, update: if hasPermission(businessId, 'cost.view')
          && request.resource.data.businessId == businessId
          && request.resource.data.variantId == variantId;
        allow delete: if false;
      }
      match /saleFinancials/{saleId} {
        allow read: if hasPermission(businessId, 'cost.view') || hasPermission(businessId, 'profit.view');
        allow create, update: if hasPermission(businessId, 'cost.view')
          && request.resource.data.businessId == businessId
          && request.resource.data.saleId == saleId;
        allow delete: if false;
      }
      match /stockMovementFinancials/{movementId} {
        allow read: if hasPermission(businessId, 'cost.view');
        allow create, update: if hasPermission(businessId, 'cost.view')
          && request.resource.data.businessId == businessId
          && request.resource.data.stockMovementId == movementId;
        allow delete: if false;
      }
      match /stockMovements/{movementId} {
        allow read: if hasPermission(businessId, 'inventory.view')
          && (!resource.data.keys().hasAny(['custoUnitario', 'costUnit']) || legacySensitiveFieldsAllowed(businessId) || permissionGranted(businessId, 'cost.view'));
        allow create, update: if canWriteCollection(businessId, 'stockMovements')
          && request.resource.data.businessId == businessId
          && !request.resource.data.keys().hasAny(['custoUnitario', 'costUnit']);
        allow delete: if false;
      }
      match /activityEvents/{eventId} {
        allow read: if belongsToBusiness(businessId)
          && (permissionGranted(businessId, 'sales.viewAll') || resource.data.get('actorUid', '') == request.auth.uid)
          && (!('spaceId' in resource.data) || canAccessSpace(businessId, resource.data.spaceId));
        allow create, update, delete: if false;
      }
      match /products/{productId} {
        allow read: if hasPermission(businessId, 'products.view')
          && (resource == null || !resource.data.keys().hasAny(['custo', 'cost']) || legacySensitiveFieldsAllowed(businessId) || permissionGranted(businessId, 'cost.view'));
        allow create: if canWriteCollection(businessId, 'products')
          && (!memberExists(businessId) || permissionGranted(businessId, 'products.edit'))
          && request.resource.data.businessId == businessId
          && (!request.resource.data.keys().hasAny(['custo', 'cost']) || legacySensitiveFieldsAllowed(businessId))
          && validProductSpaceScope(request.resource.data, businessId);
        allow update: if canWriteCollection(businessId, 'products')
          && (
            !memberExists(businessId)
            || permissionGranted(businessId, 'products.edit')
            || (
              (permissionGranted(businessId, 'inventory.adjust') || permissionGranted(businessId, 'sales.create'))
              && onlyOperationalProductStockChanged(request.resource.data, resource.data)
            )
          )
          && (resource.data.businessId == businessId || (businessId == 'adi-festa' && !('businessId' in resource.data)))
          && request.resource.data.businessId == businessId
          && (!request.resource.data.keys().hasAny(['custo', 'cost']) || legacySensitiveFieldsAllowed(businessId))
          && validProductItemKind(request.resource.data)
          && (
            validProductSpaceScope(request.resource.data, businessId)
            || preservesProductSpaceScope(request.resource.data, resource.data)
          );
        allow delete: if false;
      }
      match /sales/{saleId} {
        allow read: if belongsToBusiness(businessId)
          && (
            resource == null
            || (
              (!memberExists(businessId) || permissionGranted(businessId, 'sales.viewAll') || resource.data.get('actorUid', '') == request.auth.uid)
              && (!('spaceId' in resource.data) || canAccessSpace(businessId, resource.data.spaceId))
              && (!resource.data.keys().hasAny(['custoTotal', 'lucro']) || legacySensitiveFieldsAllowed(businessId) || permissionGranted(businessId, 'cost.view') || permissionGranted(businessId, 'profit.view'))
            )
          );
        allow create: if canWriteCollection(businessId, 'sales')
          && request.resource.data.businessId == businessId
          && (!memberExists(businessId) || request.resource.data.get('actorUid', '') == request.auth.uid)
          && (!request.resource.data.keys().hasAny(['custoTotal', 'lucro']) || legacySensitiveFieldsAllowed(businessId))
          && validSaleSpace(request.resource.data, businessId);
        allow update: if canWriteCollection(businessId, 'sales')
          && (
            !memberExists(businessId)
            || (
              permissionGranted(businessId, 'sales.cancel')
              && (roleForBusiness(businessId) == 'owner' || canAccessSpace(businessId, resource.data.get('spaceId', '')))
              && preservesSaleActor(request.resource.data, resource.data)
            )
          )
          && (resource.data.businessId == businessId || (businessId == 'adi-festa' && !('businessId' in resource.data)))
          && request.resource.data.businessId == businessId
          && (!request.resource.data.keys().hasAny(['custoTotal', 'lucro']) || legacySensitiveFieldsAllowed(businessId))
          && (
            (
              'spaceId' in resource.data
              && preservesSaleSpaceAssignment(request.resource.data, resource.data, businessId)
            )
            || (
              !('spaceId' in resource.data)
              && (!('spaceId' in request.resource.data) || validSaleSpace(request.resource.data, businessId))
            )
          );
        allow delete: if false;
      }
      match /clients/{documentId} {
        allow read: if canReadCollection(businessId, 'clients');
        allow create: if canCreateGenericDocument(businessId, 'clients', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'clients', documentId);
        allow delete: if false;
      }
      match /payments/{documentId} {
        allow read: if canReadCollection(businessId, 'payments');
        allow create: if canCreateGenericDocument(businessId, 'payments', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'payments', documentId);
        allow delete: if false;
      }
      match /balanceAdjustments/{documentId} {
        allow read: if canReadCollection(businessId, 'balanceAdjustments');
        allow create: if canCreateGenericDocument(businessId, 'balanceAdjustments', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'balanceAdjustments', documentId);
        allow delete: if false;
      }
      match /balanceEvents/{documentId} {
        allow read: if canReadCollection(businessId, 'balanceEvents');
        allow create: if canCreateGenericDocument(businessId, 'balanceEvents', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'balanceEvents', documentId);
        allow delete: if false;
      }
      match /campaigns/{documentId} {
        allow read: if canReadCollection(businessId, 'campaigns');
        allow create: if canCreateGenericDocument(businessId, 'campaigns', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'campaigns', documentId);
        allow delete: if false;
      }
      match /campaignProgress/{documentId} {
        allow read: if canReadCollection(businessId, 'campaignProgress');
        allow create: if canCreateGenericDocument(businessId, 'campaignProgress', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'campaignProgress', documentId);
        allow delete: if false;
      }
      match /rewards/{documentId} {
        allow read: if canReadCollection(businessId, 'rewards');
        allow create: if canCreateGenericDocument(businessId, 'rewards', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'rewards', documentId);
        allow delete: if false;
      }
      match /charges/{documentId} {
        allow read: if canReadCollection(businessId, 'charges');
        allow create: if canCreateGenericDocument(businessId, 'charges', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'charges', documentId);
        allow delete: if false;
      }
      match /messageHistory/{documentId} {
        allow read: if canReadCollection(businessId, 'messageHistory');
        allow create: if canCreateGenericDocument(businessId, 'messageHistory', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'messageHistory', documentId);
        allow delete: if false;
      }
      match /messageTemplates/{documentId} {
        allow read: if canReadCollection(businessId, 'messageTemplates');
        allow create: if canCreateGenericDocument(businessId, 'messageTemplates', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'messageTemplates', documentId);
        allow delete: if false;
      }
      match /messageSequences/{documentId} {
        allow read: if canReadCollection(businessId, 'messageSequences');
        allow create: if canCreateGenericDocument(businessId, 'messageSequences', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'messageSequences', documentId);
        allow delete: if false;
      }
      match /clientContacts/{documentId} {
        allow read: if canReadCollection(businessId, 'clientContacts');
        allow create: if canCreateGenericDocument(businessId, 'clientContacts', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'clientContacts', documentId);
        allow delete: if false;
      }
      match /customerSubscriptions/{documentId} {
        allow read: if canReadCollection(businessId, 'customerSubscriptions');
        allow create: if canCreateGenericDocument(businessId, 'customerSubscriptions', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'customerSubscriptions', documentId);
        allow delete: if false;
      }
      match /catalogOrders/{documentId} {
        allow read: if canReadCollection(businessId, 'catalogOrders');
        allow create: if canCreateGenericDocument(businessId, 'catalogOrders', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'catalogOrders', documentId);
        allow delete: if false;
      }
      match /customerMetrics/{documentId} {
        allow read: if canReadCollection(businessId, 'customerMetrics');
        allow create: if canCreateGenericDocument(businessId, 'customerMetrics', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'customerMetrics', documentId);
        allow delete: if false;
      }
      match /customerMonthlyMetrics/{documentId} {
        allow read: if canReadCollection(businessId, 'customerMonthlyMetrics');
        allow create: if canCreateGenericDocument(businessId, 'customerMonthlyMetrics', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'customerMonthlyMetrics', documentId);
        allow delete: if false;
      }
      match /customerSegments/{documentId} {
        allow read: if canReadCollection(businessId, 'customerSegments');
        allow create: if canCreateGenericDocument(businessId, 'customerSegments', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'customerSegments', documentId);
        allow delete: if false;
      }
      match /visits/{documentId} {
        allow read: if canReadCollection(businessId, 'visits');
        allow create: if canCreateGenericDocument(businessId, 'visits', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'visits', documentId);
        allow delete: if false;
      }
      match /settings/{documentId} {
        allow read: if canReadCollection(businessId, 'settings');
        allow create: if canCreateGenericDocument(businessId, 'settings', documentId)
          || (documentId == 'operation' && hasPermission(businessId, 'settings.manage') && request.resource.data.businessId == businessId);
        allow update: if canUpdateGenericDocument(businessId, 'settings', documentId)
          || (documentId == 'operation' && hasPermission(businessId, 'settings.manage') && resource.data.businessId == businessId && request.resource.data.businessId == businessId);
        allow delete: if false;
      }
      match /syncMetadata/{documentId} {
        allow read: if canReadCollection(businessId, 'syncMetadata');
        allow create: if canCreateGenericDocument(businessId, 'syncMetadata', documentId);
        allow update: if canUpdateGenericDocument(businessId, 'syncMetadata', documentId);
        allow delete: if false;
      }
    }

    match /financialSpaces/{spaceId} {
      allow read: if signedIn() && resource.data.active != false && (
        (
          resource.data.type == 'business'
          && (
            ownsActiveBusiness(resource.data.linkedBusinessId)
            || canAccessSpace(resource.data.linkedBusinessId, spaceId)
          )
        )
        || (
          resource.data.type in ['personal', 'other']
          && resource.data.ownerUid == request.auth.uid
        )
      );
      allow create: if signedIn()
        && !(spaceId in ['all', 'all_spaces'])
        && request.resource.data.id == spaceId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['business', 'personal', 'other']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (
          (
            request.resource.data.type == 'business'
            && request.resource.data.linkedBusinessId is string
            && subscriptionAllowsWrites(request.resource.data.linkedBusinessId)
            && (
              ownsActiveBusiness(request.resource.data.linkedBusinessId)
              || (
                belongsToBusiness(request.resource.data.linkedBusinessId)
                && permissionGranted(request.resource.data.linkedBusinessId, 'spaces.manage')
              )
            )
          )
          || (
            request.resource.data.type in ['personal', 'other']
            && request.resource.data.linkedBusinessId == null
          )
        )
        && (!('globalSpaceSchemaVersion' in request.resource.data) || validGlobalSpaceFields(request.resource.data, spaceId));
      allow update: if canManageFinancialSpace(spaceId)
        && (
          resource.data.type in ['personal', 'other']
          || ownsActiveBusiness(resource.data.linkedBusinessId)
          || hasPermission(resource.data.linkedBusinessId, 'spaces.manage')
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.type == resource.data.type
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.linkedBusinessId == resource.data.linkedBusinessId
        && (
          (
            !('globalSpaceSchemaVersion' in resource.data)
            && !('globalSpaceSchemaVersion' in request.resource.data)
          )
          || validGlobalSpaceFields(request.resource.data, spaceId)
        );
      allow delete: if false;

      match /entries/{entryId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == entryId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.operationId is string
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.currency == 'BRL'
          && request.resource.data.direction in ['in', 'out']
          && (!('autoGenerated' in request.resource.data) || request.resource.data.autoGenerated != true)
          && validFinancialEntryAccount(spaceId, request.resource.data)
          && validFinancialEntryCreditPayment(spaceId, request.resource.data)
          && request.resource.data.status in ['pending', 'paid', 'cancelled', 'reversed'];
        allow update: if canManageFinancialSpace(spaceId)
          && (!('autoGenerated' in resource.data) || resource.data.autoGenerated != true)
          && (!('autoGenerated' in request.resource.data) || request.resource.data.autoGenerated != true)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && (
            request.resource.data.amountCents == resource.data.amountCents
            || (
              resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.amountCents is int
              && request.resource.data.amountCents > 0
            )
          )
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.direction == resource.data.direction
          && request.resource.data.sourceType == resource.data.sourceType
          && request.resource.data.sourceId == resource.data.sourceId
          && validFinancialEntryAccount(spaceId, request.resource.data)
          && validFinancialEntryCreditPayment(spaceId, request.resource.data)
          && request.resource.data.status in ['pending', 'paid', 'cancelled', 'reversed'];
        allow delete: if false;
      }
      match /events/{eventId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == eventId
          && request.resource.data.operationId == eventId
          && request.resource.data.financialSpaceId == spaceId
          && (!('autoGenerated' in request.resource.data) || request.resource.data.autoGenerated != true)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
      match /categories/{categoryId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == categoryId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.ownerUid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.type in ['category', 'subcategory']
          && request.resource.data.isDefault == false
          && request.resource.data.active == true
          && (
            (request.resource.data.type == 'category' && request.resource.data.parentCategoryId == null)
            || (
              request.resource.data.type == 'subcategory'
              && request.resource.data.parentCategoryId is string
              && request.resource.data.parentCategoryId.size() > 0
              && (
                request.resource.data.parentCategoryId.matches('^default_(business|personal)_[a-z0-9_]+$')
                || (
                  exists(/databases/$(database)/documents/financialSpaces/$(spaceId)/categories/$(request.resource.data.parentCategoryId))
                  && get(/databases/$(database)/documents/financialSpaces/$(spaceId)/categories/$(request.resource.data.parentCategoryId)).data.type == 'category'
                )
              )
            )
          );
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.parentCategoryId == resource.data.parentCategoryId
          && request.resource.data.isDefault == resource.data.isDefault
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow delete: if false;
      }
      match /recurrences/{recurrenceId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == recurrenceId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if false;
      }
      match /financialAccounts/{accountId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == accountId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.type in ['cash', 'checking', 'wallet', 'savings', 'other', 'bank_account', 'digital_wallet', 'cash_wallet', 'investment_account', 'other_account']
          && request.resource.data.initialBalanceCents is int
          && (!('currentBalanceCents' in request.resource.data) || request.resource.data.currentBalanceCents is int)
          && (!('includeInAvailableBalance' in request.resource.data) || request.resource.data.includeInAvailableBalance is bool)
          && validFinancialAccountAccess(request.resource.data, spaceId)
          && request.resource.data.active == true;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && request.resource.data.type == resource.data.type
          && request.resource.data.initialBalanceCents is int
          && (!('currentBalanceCents' in request.resource.data) || request.resource.data.currentBalanceCents is int)
          && (!('includeInAvailableBalance' in request.resource.data) || request.resource.data.includeInAvailableBalance is bool)
          && request.resource.data.active is bool
          && financialAccountScopeUpdateAllowed(resource.data, request.resource.data, spaceId);
        allow delete: if false;
      }
      match /creditCards/{cardId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == cardId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (
            request.resource.data.last4 == null
            || (request.resource.data.last4 is string && request.resource.data.last4.matches('^[0-9]{4}$'))
          )
          && request.resource.data.limitCents is int
          && request.resource.data.limitCents >= 0
          && request.resource.data.committedCents == 0
          && request.resource.data.closingDay is int
          && request.resource.data.closingDay >= 1
          && request.resource.data.closingDay <= 31
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && validCreditCardAccess(request.resource.data, spaceId)
          && request.resource.data.active == true;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && (
            request.resource.data.last4 == null
            || (request.resource.data.last4 is string && request.resource.data.last4.matches('^[0-9]{4}$'))
          )
          && request.resource.data.limitCents is int
          && request.resource.data.limitCents >= 0
          && request.resource.data.committedCents is int
          && request.resource.data.committedCents >= 0
          && request.resource.data.closingDay is int
          && request.resource.data.closingDay >= 1
          && request.resource.data.closingDay <= 31
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && request.resource.data.active is bool
          && creditCardScopeUpdateAllowed(resource.data, request.resource.data, spaceId);
        allow delete: if false;
      }
      match /creditCardInvoices/{invoiceId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == invoiceId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.creditCardId is string
          && request.resource.data.cardHomeSpaceId == spaceId
          && exists(/databases/$(database)/documents/financialSpaces/$(spaceId)/creditCards/$(request.resource.data.creditCardId))
          && request.resource.data.spaceTotals is map
          && request.resource.data.categoryTotals is map
          && request.resource.data.spacesUsedIds is list
          && request.resource.data.referenceYear is int
          && request.resource.data.referenceMonth is int
          && request.resource.data.referenceMonth >= 1
          && request.resource.data.referenceMonth <= 12
          && request.resource.data.purchasesTotalCents is int
          && request.resource.data.purchasesTotalCents >= 0
          && request.resource.data.adjustmentsTotalCents is int
          && request.resource.data.paidTotalCents is int
          && request.resource.data.paidTotalCents >= 0
          && request.resource.data.remainingCents is int
          && request.resource.data.remainingCents >= 0
          && request.resource.data.status in ['open', 'closed', 'paid', 'overdue', 'cancelled'];
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && request.resource.data.creditCardId == resource.data.creditCardId
          && (!('cardHomeSpaceId' in request.resource.data) || request.resource.data.cardHomeSpaceId == spaceId)
          && (!('spaceTotals' in request.resource.data) || request.resource.data.spaceTotals is map)
          && (!('categoryTotals' in request.resource.data) || request.resource.data.categoryTotals is map)
          && (!('spacesUsedIds' in request.resource.data) || request.resource.data.spacesUsedIds is list)
          && request.resource.data.referenceYear == resource.data.referenceYear
          && request.resource.data.referenceMonth == resource.data.referenceMonth
          && request.resource.data.openingDate == resource.data.openingDate
          && request.resource.data.closingDate == resource.data.closingDate
          && request.resource.data.dueDate == resource.data.dueDate
          && request.resource.data.purchasesTotalCents is int
          && request.resource.data.purchasesTotalCents >= resource.data.purchasesTotalCents
          && request.resource.data.adjustmentsTotalCents is int
          && request.resource.data.paidTotalCents is int
          && request.resource.data.paidTotalCents >= resource.data.paidTotalCents
          && request.resource.data.remainingCents is int
          && request.resource.data.remainingCents >= 0
          && request.resource.data.status in ['open', 'closed', 'paid', 'overdue', 'cancelled'];
        allow delete: if false;
      }
      match /creditCardPurchases/{purchaseId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == purchaseId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.creditCardId is string
          && request.resource.data.creditCardInvoiceId is string
          && request.resource.data.cardHomeSpaceId is string
          && validCrossSpaceCardUse(spaceId, request.resource.data.cardHomeSpaceId, request.resource.data.creditCardId)
          && existsAfter(/databases/$(database)/documents/financialSpaces/$(request.resource.data.cardHomeSpaceId)/creditCardInvoices/$(request.resource.data.creditCardInvoiceId))
          && getAfter(/databases/$(database)/documents/financialSpaces/$(request.resource.data.cardHomeSpaceId)/creditCardInvoices/$(request.resource.data.creditCardInvoiceId)).data.creditCardId == request.resource.data.creditCardId
          && request.resource.data.installmentGroupId is string
          && request.resource.data.installmentNumber is int
          && request.resource.data.installmentNumber >= 1
          && request.resource.data.installmentCount is int
          && request.resource.data.installmentCount >= request.resource.data.installmentNumber
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.status == 'posted';
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && request.resource.data.creditCardId == resource.data.creditCardId
          && request.resource.data.creditCardInvoiceId == resource.data.creditCardInvoiceId
          && request.resource.data.cardHomeSpaceId == resource.data.cardHomeSpaceId
          && request.resource.data.installmentGroupId == resource.data.installmentGroupId
          && request.resource.data.installmentNumber == resource.data.installmentNumber
          && request.resource.data.installmentCount == resource.data.installmentCount
          && request.resource.data.amountCents == resource.data.amountCents
          && resource.data.status == 'posted'
          && request.resource.data.status == 'voided'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'voidedAt', 'voidedByOperationId', 'updatedAt'
          ]);
        allow delete: if false;
      }
      match /creditCardInvoicePayments/{paymentId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == paymentId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.creditCardInvoiceId is string
          && request.resource.data.creditCardId is string
          && request.resource.data.financialAccountId is string
          && request.resource.data.cardHomeSpaceId == spaceId
          && request.resource.data.paymentFinancialSpaceId is string
          && canManageFinancialSpace(request.resource.data.paymentFinancialSpaceId)
          && validCrossSpaceCardUse(request.resource.data.paymentFinancialSpaceId, spaceId, request.resource.data.creditCardId)
          && (
            'financialAccountHomeSpaceId' in request.resource.data
              ? request.resource.data.financialAccountHomeSpaceId is string
                && validCrossSpaceFinancialAccountUse(request.resource.data.paymentFinancialSpaceId, request.resource.data.financialAccountHomeSpaceId, request.resource.data.financialAccountId)
              : exists(/databases/$(database)/documents/financialSpaces/$(request.resource.data.paymentFinancialSpaceId)/financialAccounts/$(request.resource.data.financialAccountId))
          )
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.paymentMethod in ['cash', 'pix', 'debit_card', 'automatic_debit', 'transfer', 'other']
          && request.resource.data.status == 'confirmed';
        allow update, delete: if false;
      }
      match /creditCardAdjustments/{adjustmentId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == adjustmentId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.creditCardInvoiceId is string
          && request.resource.data.creditCardId is string
          && request.resource.data.cardHomeSpaceId == spaceId
          && (
            (
              request.resource.data.kind == 'opening_balance'
              && !('creditCardPurchaseId' in request.resource.data)
              && !('purchaseFinancialSpaceId' in request.resource.data)
            )
            || (
              request.resource.data.kind in ['refund', 'credit', 'fee', 'bill_payment_void']
              && request.resource.data.purchaseFinancialSpaceId is string
              && canManageFinancialSpace(request.resource.data.purchaseFinancialSpaceId)
              && validCrossSpaceCardUse(request.resource.data.purchaseFinancialSpaceId, spaceId, request.resource.data.creditCardId)
              && exists(/databases/$(database)/documents/financialSpaces/$(request.resource.data.purchaseFinancialSpaceId)/creditCardPurchases/$(request.resource.data.creditCardPurchaseId))
            )
          )
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.effectCents is int
          && request.resource.data.status == 'confirmed';
        allow update, delete: if false;
      }
    }

    // Catálogo global do proprietário: a consulta collectionGroup sempre deve
    // incluir ownerUid == request.auth.uid. A regra não concede essa visão
    // consolidada a membros de empresa nem atravessa proprietários.
    match /{path=**}/creditCards/{cardId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{path=**}/financialAccounts/{accountId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /financialTransfers/{transferId} {
      allow read: if signedIn()
        && canReadFinancialSpace(resource.data.fromSpaceId)
        && canReadFinancialSpace(resource.data.toSpaceId);
      allow create: if signedIn()
        && request.resource.data.id == transferId
        && request.resource.data.operationId == transferId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && (
          request.resource.data.fromSpaceId != request.resource.data.toSpaceId
          || (
            request.resource.data.fromFinancialAccountId is string
            && request.resource.data.toFinancialAccountId is string
            && request.resource.data.fromFinancialAccountId != request.resource.data.toFinancialAccountId
          )
        )
        && canManageFinancialSpace(request.resource.data.fromSpaceId)
        && canManageFinancialSpace(request.resource.data.toSpaceId)
        && (
          !('fromFinancialAccountId' in request.resource.data) || request.resource.data.fromFinancialAccountId == null
            ? true
            : 'fromFinancialAccountHomeSpaceId' in request.resource.data
              ? request.resource.data.fromFinancialAccountHomeSpaceId is string
                && validCrossSpaceFinancialAccountUse(request.resource.data.fromSpaceId, request.resource.data.fromFinancialAccountHomeSpaceId, request.resource.data.fromFinancialAccountId)
              : exists(/databases/$(database)/documents/financialSpaces/$(request.resource.data.fromSpaceId)/financialAccounts/$(request.resource.data.fromFinancialAccountId))
        )
        && (
          !('toFinancialAccountId' in request.resource.data) || request.resource.data.toFinancialAccountId == null
            ? true
            : 'toFinancialAccountHomeSpaceId' in request.resource.data
              ? request.resource.data.toFinancialAccountHomeSpaceId is string
                && validCrossSpaceFinancialAccountUse(request.resource.data.toSpaceId, request.resource.data.toFinancialAccountHomeSpaceId, request.resource.data.toFinancialAccountId)
              : exists(/databases/$(database)/documents/financialSpaces/$(request.resource.data.toSpaceId)/financialAccounts/$(request.resource.data.toFinancialAccountId))
        );
      allow update, delete: if false;
    }

    match /subscriptionIndex/{subscriptionId} {
      allow read, write: if false;
    }
    match /billingOrderIndex/{orderId} {
      allow read, write: if false;
    }
    match /billingPaymentEvents/{eventId} {
      allow read, write: if false;
    }

    // Cupons, cotações, contadores, resgates e auditoria são acessados apenas
    // pelas Cloud Functions. Nem a conta interna altera valores diretamente.
    match /adminCoupons/{couponId} {
      allow read, write: if false;
    }
    match /adminCouponCodes/{codeHash} {
      allow read, write: if false;
    }
    match /couponQuotes/{quoteId} {
      allow read, write: if false;
    }
    match /couponRedemptions/{redemptionId} {
      allow read, write: if false;
    }
    match /couponUsageCounters/{counterId} {
      allow read, write: if false;
    }
    match /couponAuditLogs/{logId} {
      allow read, write: if false;
    }
    match /couponBillingEvents/{eventId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
