rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function validRole(role) {
      return role in ['owner', 'admin', 'manager', 'cashier', 'viewer', 'platform_admin'];
    }
    function activeUser() {
      return profileExists() && userProfile().active == true && validRole(userProfile().role);
    }
    function currentBusinessId() {
      return userProfile().businessId;
    }
    function businessExists(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId));
    }
    function activeBusiness(businessId) {
      return businessExists(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.active == true;
    }
    function subscriptionAllowsWrites(businessId) {
      let business = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      let subscription = business.subscription;
      return business.active == true
        && (
          (subscription.planId == 'internal' && subscription.status == 'active')
          || subscription.status == 'active'
          || (subscription.status in ['trial', 'trialing'] && subscription.trialEndsAt > request.time)
          || (
            subscription.status == 'grace_period'
            && (!('gracePeriodEndsAt' in subscription) || subscription.gracePeriodEndsAt > request.time)
          )
        );
    }
    function planAllowsCollection(businessId, collectionName) {
      let subscription = get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription;
      return !(collectionName in [
          'campaigns', 'campaignProgress', 'campaignEvents',
          'campaignRedemptions', 'paymentAllocations', 'rewards', 'charges',
          'customerSubscriptions', 'customerSubscriptionEvents',
          'messageHistory', 'messageTemplates', 'messageSequences',
          'visits', 'catalogOrders'
        ])
        || subscription.planId in ['internal', 'trial', 'professional', 'premium'];
    }
    function belongsToBusiness(businessId) {
      return activeUser()
        && currentBusinessId() == businessId
        && activeBusiness(businessId);
    }
    function isOwner(businessId) {
      return belongsToBusiness(businessId)
        && userProfile().role == 'owner'
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    function isAdmin(businessId) {
      return belongsToBusiness(businessId) && userProfile().role in ['owner', 'admin'];
    }
    function hasPermission(businessId, permission) {
      return belongsToBusiness(businessId) && (
        userProfile().role in ['owner', 'platform_admin']
        || (userProfile().role == 'admin' && permission != 'exportCRM')
        || (userProfile().permissions is map && userProfile().permissions[permission] == true)
      );
    }
    function canWriteCollection(businessId, collectionName) {
      return belongsToBusiness(businessId)
        && subscriptionAllowsWrites(businessId)
        && planAllowsCollection(businessId, collectionName)
        && (
          userProfile().role in ['owner', 'admin', 'manager']
          || (
            userProfile().role == 'cashier'
            && collectionName in [
              'clients', 'sales', 'payments', 'balanceEvents',
              'charges', 'messageHistory', 'clientContacts', 'catalogOrders',
              'campaignProgress', 'campaignEvents', 'campaignRedemptions',
              'paymentAllocations', 'customerSubscriptions',
              'customerSubscriptionEvents'
            ]
          )
        );
    }
    function financialSpace(spaceId) {
      return get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data;
    }
    function canReadFinancialSpace(spaceId) {
      let space = financialSpace(spaceId);
      return signedIn() && space.active != false && (
        (space.type == 'business' && belongsToBusiness(space.linkedBusinessId))
        || (space.type in ['personal', 'other'] && space.ownerUid == request.auth.uid)
      );
    }
    function canManageFinancialSpace(spaceId) {
      let space = financialSpace(spaceId);
      return signedIn() && space.active != false && (
        (
          space.type == 'business'
          && belongsToBusiness(space.linkedBusinessId)
          && subscriptionAllowsWrites(space.linkedBusinessId)
          && userProfile().role in ['owner', 'admin', 'manager']
        )
        || (space.type in ['personal', 'other'] && space.ownerUid == request.auth.uid)
      );
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // O primeiro perfil é criado apenas pela completeBusinessOnboarding.
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.uid == resource.data.uid
          || (
            resource.data.businessId == 'adi-festa'
            && !('uid' in resource.data)
            && request.resource.data.uid == request.auth.uid
          )
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && request.resource.data.businessId == resource.data.businessId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'migrationVersion', 'migratedAt'
          ])
          || (
            resource.data.businessId == 'adi-festa'
            && get(/databases/$(database)/documents/businesses/adi-festa).data.ownerId == request.auth.uid
          )
        )
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.businessId == 'adi-festa'
            && resource.data.role == 'admin'
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/businesses/adi-festa).data.ownerId == request.auth.uid
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'phone', 'role', 'permissions', 'onboardingCompleted',
          'lastLoginAt', 'migrationVersion', 'migratedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /publicCatalogs/{visitToken} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.businessId is string
        && belongsToBusiness(request.resource.data.businessId)
        && subscriptionAllowsWrites(request.resource.data.businessId)
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.subscription.planId in ['internal', 'trial', 'professional', 'premium'];
      allow update: if signedIn()
        && resource.data.businessId == request.resource.data.businessId
        && belongsToBusiness(resource.data.businessId)
        && subscriptionAllowsWrites(resource.data.businessId)
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.subscription.planId in ['internal', 'trial', 'professional', 'premium'];
      allow delete: if false;

      match /orders/{orderId} {
        function catalog() {
          return get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data;
        }
        // Pedidos públicos são validados e gravados exclusivamente pela
        // Cloud Function submitCatalogOrder. O Admin SDK ignora estas regras.
        allow create: if false;
        allow get: if true;
        allow list, update: if signedIn() && belongsToBusiness(catalog().businessId);
        allow delete: if false;
      }

      match /campaignProgress/{phoneHash} {
        allow get: if true;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /phoneIndex/{phoneHash} {
        // A busca por telefone passa pela função com rate limit e resposta uniforme.
        allow get: if false;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /portalProfiles/{clientRefToken} {
        allow get: if true;
        allow list: if false;
        allow create, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /portalSessions/{sessionHash} {
        allow get: if true;
        allow list: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow create: if false;
        allow update: if belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
      match /redemptionRequests/{requestId} {
        allow create: if request.resource.data.id == requestId
          && request.resource.data.status == 'solicitado'
          && request.resource.data.businessId == get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId
          && request.resource.data.visitId == get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.visitId
          && request.resource.data.clientRefToken is string
          && request.resource.data.portalSessionHash is string
          && exists(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash))
          && get(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash)).data.active == true
          && get(/databases/$(database)/documents/publicCatalogs/$(visitToken)/portalSessions/$(request.resource.data.portalSessionHash)).data.clientRefToken == request.resource.data.clientRefToken;
        allow get: if true;
        allow list, update: if signedIn() && belongsToBusiness(get(/databases/$(database)/documents/publicCatalogs/$(visitToken)).data.businessId);
        allow delete: if false;
      }
    }

    match /businesses/{businessId} {
      // Empresas e trials iniciais são provisionados exclusivamente pelo backend.
      allow create: if false;
      allow read: if belongsToBusiness(businessId);
      allow update: if (
        isOwner(businessId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.subscription == resource.data.subscription
          && request.resource.data.limits == resource.data.limits
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'legalName', 'document', 'phone', 'email', 'businessType',
            'city', 'state', 'address', 'receiptName', 'active',
            'onboardingCompleted', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && businessId == 'adi-festa'
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            (
              !('subscription' in resource.data)
              && request.resource.data.subscription.planId == 'internal'
              && request.resource.data.subscription.status == 'active'
            )
            || request.resource.data.subscription == resource.data.subscription
          )
          && (
            !('limits' in resource.data)
            || request.resource.data.limits == resource.data.limits
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'slug', 'onboardingCompleted', 'businessType', 'subscription',
            'limits', 'migrationVersion', 'migratedAt', 'updatedAt'
          ])
        );
      allow delete: if false;

      match /billingCheckoutAttempts/{attemptId} {
        allow read: if isOwner(businessId)
          && resource.data.businessId == businessId
          && resource.data.requestedBy == request.auth.uid;
        allow create, update, delete: if false;
      }
      match /subscriptionIntents/{intentId} {
        allow read: if isOwner(businessId);
        allow create, update, delete: if false;
      }
      match /invites/{inviteId} {
        allow read: if isAdmin(businessId);
        allow create: if isOwner(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(businessId);
        allow delete: if false;
      }
      match /auditLogs/{logId} {
        allow read: if isOwner(businessId);
        allow create: if belongsToBusiness(businessId)
          && request.resource.data.businessId == businessId;
        allow update, delete: if false;
      }
      match /productVariants/{variantId} {
        function parentProduct(productId) {
          // A criação de um produto variável grava o pai e suas variações na
          // mesma transação offline-first. getAfter também enxerga o produto
          // pai que será criado por essa transação; get enxergava apenas o
          // estado anterior e rejeitava toda a operação com permission-denied.
          return getAfter(/databases/$(database)/documents/businesses/$(businessId)/products/$(productId));
        }
        function validVariant(data) {
          return data.id == variantId
            && data.businessId == businessId
            && data.parentProductId is string
            && data.displayName is string
            && data.attributeValues is map
            && data.price is number
            && data.stock is number
            && data.active is bool
            && data.keys().hasOnly([
              'id', 'businessId', 'ownerId', 'parentProductId',
              'attributeValues', 'displayName', 'displayNameNormalized',
              'searchTokens', 'sku', 'barcode', 'price', 'cost', 'stock',
              'minStock', 'active', 'catalogVisible', 'allowNegativeStock',
              'durationValue', 'durationUnit',
              'image', 'imageMode', 'imageUrl', 'imageStoragePath',
              'imageThumbUrl', 'imageThumbStoragePath', 'imageUpdatedAt',
              'imageUploadStatus', 'imageOperationId',
              'createdAt', 'updatedAt', 'schemaVersion', 'version'
            ]);
        }
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'productVariants')
          && validVariant(request.resource.data)
          && parentProduct(request.resource.data.parentProductId).data.businessId == businessId;
        allow update: if canWriteCollection(businessId, 'productVariants')
          && validVariant(request.resource.data)
          && request.resource.data.parentProductId == resource.data.parentProductId
          && request.resource.data.businessId == resource.data.businessId;
        allow delete: if false;
      }
      match /processedOperations/{operationId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if belongsToBusiness(businessId)
          && subscriptionAllowsWrites(businessId)
          && userProfile().role in ['owner', 'admin', 'manager', 'cashier']
          && request.resource.data.id == operationId
          && request.resource.data.idempotencyKey == operationId
          && request.resource.data.businessId == businessId
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.status in ['processed', 'recovered_existing']
          && request.resource.data.schemaVersion == 3
          && request.resource.data.keys().hasOnly([
            'id', 'idempotencyKey', 'businessId', 'ownerId', 'status',
            'eventKind', 'processedAt', 'createdAtLocal', 'schemaVersion'
          ]);
        allow update, delete: if false;
      }
      match /campaignEvents/{eventId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'campaignEvents')
          && request.resource.data.id == eventId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.campaignId is string
          && request.resource.data.clientId is string
          && request.resource.data.sourceType in ['sale', 'payment', 'cancellation', 'redemption', 'expiration']
          && request.resource.data.transition in ['earned', 'confirmed', 'reversed', 'redeemed', 'expired'];
        allow update, delete: if false;
      }
      match /campaignRedemptions/{redemptionId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'campaignRedemptions')
          && request.resource.data.id == redemptionId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.campaignId is string
          && request.resource.data.clientId is string
          && request.resource.data.status == 'redeemed';
        allow update, delete: if false;
      }
      match /paymentAllocations/{allocationId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'paymentAllocations')
          && request.resource.data.id == allocationId
          && request.resource.data.businessId == businessId
          && request.resource.data.engineVersion == 2
          && request.resource.data.paymentId is string
          && request.resource.data.saleId is string
          && request.resource.data.clientId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update, delete: if false;
      }
      match /customerSubscriptionEvents/{eventId} {
        allow read: if belongsToBusiness(businessId);
        allow create: if canWriteCollection(businessId, 'customerSubscriptionEvents')
          && request.resource.data.id == eventId
          && request.resource.data.businessId == businessId
          && request.resource.data.subscriptionId is string
          && request.resource.data.clientId is string
          && request.resource.data.productId is string
          && request.resource.data.transition in ['activation', 'renewal', 'paused', 'reactivated', 'expired', 'cancelled', 'sale_reversed', 'price_changed', 'plan_changed'];
        allow update, delete: if false;
      }
      match /{collectionName}/{documentId} {
        allow read: if !(collectionName in ['productVariants', 'processedOperations', 'billingCheckoutAttempts', 'subscriptionIntents', 'campaignEvents', 'campaignRedemptions', 'paymentAllocations', 'customerSubscriptionEvents'])
          && belongsToBusiness(businessId)
          && (!(collectionName in ['customerMetrics', 'customerMonthlyMetrics', 'customerSegments']) || hasPermission(businessId, 'viewCRM'));
        allow create: if !(collectionName in ['productVariants', 'processedOperations', 'billingCheckoutAttempts', 'subscriptionIntents', 'campaignEvents', 'campaignRedemptions', 'paymentAllocations', 'customerSubscriptionEvents'])
          && (canWriteCollection(businessId, collectionName) || (collectionName == 'settings' && documentId == 'operation' && hasPermission(businessId, 'manageOperationSettings')))
          && request.resource.data.businessId == businessId
          && (collectionName != 'customerSegments' || hasPermission(businessId, 'manageCustomerSegments'))
          && (
            collectionName != 'settings'
            || documentId != 'operation'
            || hasPermission(businessId, 'manageOperationSettings')
          );
        allow update: if !(collectionName in ['productVariants', 'processedOperations', 'billingCheckoutAttempts', 'subscriptionIntents', 'campaignEvents', 'campaignRedemptions', 'paymentAllocations', 'customerSubscriptionEvents'])
          && (canWriteCollection(businessId, collectionName) || (collectionName == 'settings' && documentId == 'operation' && hasPermission(businessId, 'manageOperationSettings')))
          && (
            resource.data.businessId == businessId
            || (businessId == 'adi-festa' && !('businessId' in resource.data))
          )
          && request.resource.data.businessId == businessId
          && (collectionName != 'customerSegments' || hasPermission(businessId, 'manageCustomerSegments'))
          && (collectionName != 'settings' || documentId != 'operation' || hasPermission(businessId, 'manageOperationSettings'));
        allow delete: if false;
      }
    }

    match /financialSpaces/{spaceId} {
      allow read: if signedIn() && resource.data.active != false && (
        (resource.data.type == 'business' && belongsToBusiness(resource.data.linkedBusinessId))
        || (resource.data.type in ['personal', 'other'] && resource.data.ownerUid == request.auth.uid)
      );
      allow create: if signedIn()
        && request.resource.data.id == spaceId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['business', 'personal', 'other']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (
          (
            request.resource.data.type == 'business'
            && request.resource.data.linkedBusinessId is string
            && belongsToBusiness(request.resource.data.linkedBusinessId)
            && subscriptionAllowsWrites(request.resource.data.linkedBusinessId)
            && userProfile().role in ['owner', 'admin', 'manager']
          )
          || (
            request.resource.data.type in ['personal', 'other']
            && request.resource.data.linkedBusinessId == null
          )
        );
      allow update: if canManageFinancialSpace(spaceId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.type == resource.data.type
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.linkedBusinessId == resource.data.linkedBusinessId;
      allow delete: if false;

      match /entries/{entryId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == entryId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.ownerUid == financialSpace(spaceId).ownerUid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.operationId is string
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.currency == 'BRL'
          && request.resource.data.direction in ['in', 'out']
          && request.resource.data.status in ['pending', 'paid', 'cancelled', 'reversed'];
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.operationId == resource.data.operationId
          && (
            request.resource.data.amountCents == resource.data.amountCents
            || (
              resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.amountCents is int
              && request.resource.data.amountCents > 0
            )
          )
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.direction == resource.data.direction
          && request.resource.data.sourceType == resource.data.sourceType
          && request.resource.data.sourceId == resource.data.sourceId
          && request.resource.data.status in ['pending', 'paid', 'cancelled', 'reversed'];
        allow delete: if false;
      }
      match /events/{eventId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == eventId
          && request.resource.data.operationId == eventId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
      match /categories/{categoryId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == categoryId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/financialSpaces/$(spaceId)).data.ownerUid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.type in ['category', 'subcategory']
          && request.resource.data.isDefault == false
          && request.resource.data.active == true
          && (
            (request.resource.data.type == 'category' && request.resource.data.parentCategoryId == null)
            || (
              request.resource.data.type == 'subcategory'
              && request.resource.data.parentCategoryId is string
              && request.resource.data.parentCategoryId.size() > 0
              && (
                request.resource.data.parentCategoryId.matches('^default_(business|personal)_[a-z0-9_]+$')
                || (
                  exists(/databases/$(database)/documents/financialSpaces/$(spaceId)/categories/$(request.resource.data.parentCategoryId))
                  && get(/databases/$(database)/documents/financialSpaces/$(spaceId)/categories/$(request.resource.data.parentCategoryId)).data.type == 'category'
                )
              )
            )
          );
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.parentCategoryId == resource.data.parentCategoryId
          && request.resource.data.isDefault == resource.data.isDefault
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow delete: if false;
      }
      match /recurrences/{recurrenceId} {
        allow read: if canReadFinancialSpace(spaceId);
        allow create: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == recurrenceId
          && request.resource.data.financialSpaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageFinancialSpace(spaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.financialSpaceId == resource.data.financialSpaceId
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if false;
      }
    }

    match /financialTransfers/{transferId} {
      allow read: if signedIn()
        && canReadFinancialSpace(resource.data.fromSpaceId)
        && canReadFinancialSpace(resource.data.toSpaceId);
      allow create: if signedIn()
        && request.resource.data.id == transferId
        && request.resource.data.operationId == transferId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.fromSpaceId != request.resource.data.toSpaceId
        && canManageFinancialSpace(request.resource.data.fromSpaceId)
        && canManageFinancialSpace(request.resource.data.toSpaceId);
      allow update, delete: if false;
    }

    match /subscriptionIndex/{subscriptionId} {
      allow read, write: if false;
    }
    match /billingOrderIndex/{orderId} {
      allow read, write: if false;
    }
    match /billingPaymentEvents/{eventId} {
      allow read, write: if false;
    }

    // Cupons, cotações, contadores, resgates e auditoria são acessados apenas
    // pelas Cloud Functions. Nem a conta interna altera valores diretamente.
    match /adminCoupons/{couponId} {
      allow read, write: if false;
    }
    match /adminCouponCodes/{codeHash} {
      allow read, write: if false;
    }
    match /couponQuotes/{quoteId} {
      allow read, write: if false;
    }
    match /couponRedemptions/{redemptionId} {
      allow read, write: if false;
    }
    match /couponUsageCounters/{counterId} {
      allow read, write: if false;
    }
    match /couponAuditLogs/{logId} {
      allow read, write: if false;
    }
    match /couponBillingEvents/{eventId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
