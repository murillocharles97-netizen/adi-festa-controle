rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function canAccess(businessId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().businessId == businessId;
    }
    function canManageProducts(businessId) {
      return canAccess(businessId)
        && profile().role in ['owner', 'admin', 'manager'];
    }
    function financialSpace(spaceId) {
      return firestore.get(/databases/(default)/documents/financialSpaces/$(spaceId)).data;
    }
    function canAccessFinancialSpace(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/financialSpaces/$(spaceId))
        && financialSpace(spaceId).active != false
        && (
          (
            financialSpace(spaceId).type == 'business'
            && canAccess(financialSpace(spaceId).linkedBusinessId)
          )
          || (
            financialSpace(spaceId).type in ['personal', 'other']
            && financialSpace(spaceId).ownerUid == request.auth.uid
          )
        );
    }
    function canManageFinancialSpace(spaceId) {
      return canAccessFinancialSpace(spaceId)
        && (
          financialSpace(spaceId).type in ['personal', 'other']
          || profile().role in ['owner', 'admin', 'manager']
        );
    }
    match /businesses/{businessId}/products/{productId}/{fileName} {
      allow read: if canAccess(businessId);
      allow create, update: if canManageProducts(businessId)
        && fileName.matches('^(main|thumb)-[A-Za-z0-9_-]{1,80}\\.(webp|jpg)$')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.businessId == businessId
        && request.resource.metadata.productId == productId
        && request.resource.metadata.entityType == 'product';
      allow delete: if canManageProducts(businessId);
    }
    match /businesses/{businessId}/products/{productId}/variants/{variantId}/{fileName} {
      allow read: if canAccess(businessId);
      allow create, update: if canManageProducts(businessId)
        && fileName.matches('^(main|thumb)-[A-Za-z0-9_-]{1,80}\\.(webp|jpg)$')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.businessId == businessId
        && request.resource.metadata.productId == productId
        && request.resource.metadata.variantId == variantId
        && request.resource.metadata.entityType == 'productVariant';
      allow delete: if canManageProducts(businessId);
    }
    match /businesses/{businessId}/catalog/banners/{entityId}/{fileName} {
      allow read: if canAccess(businessId);
      allow create, update: if canManageProducts(businessId)
        && fileName.matches('^(main|thumb)-[A-Za-z0-9_-]{1,80}\\.(webp|jpg)$')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.businessId == businessId
        && request.resource.metadata.entityId == entityId
        && request.resource.metadata.entityType == 'catalogBanner';
      allow delete: if canManageProducts(businessId);
    }
    match /businesses/{businessId}/catalog/categories/{entityId}/{fileName} {
      allow read: if canAccess(businessId);
      allow create, update: if canManageProducts(businessId)
        && fileName.matches('^(main|thumb)-[A-Za-z0-9_-]{1,80}\\.(webp|jpg)$')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.businessId == businessId
        && request.resource.metadata.entityId == entityId
        && request.resource.metadata.entityType == 'catalogCategory';
      allow delete: if canManageProducts(businessId);
    }
    match /businesses/{businessId}/catalog/products/{entityId}/{fileName} {
      allow read: if canAccess(businessId);
      allow create, update: if canManageProducts(businessId)
        && fileName.matches('^(main|thumb)-[A-Za-z0-9_-]{1,80}\\.(webp|jpg)$')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.businessId == businessId
        && request.resource.metadata.entityId == entityId
        && request.resource.metadata.entityType == 'catalogProduct';
      allow delete: if canManageProducts(businessId);
    }
    match /financialSpaces/{spaceId}/entries/{entryId}/{fileName} {
      allow read: if canAccessFinancialSpace(spaceId)
        && firestore.exists(/databases/(default)/documents/financialSpaces/$(spaceId)/entries/$(entryId));
      allow create, update: if canManageFinancialSpace(spaceId)
        && firestore.exists(/databases/(default)/documents/financialSpaces/$(spaceId)/entries/$(entryId))
        && fileName.matches('^[A-Za-z0-9_-]{1,100}\\.(jpg|png|webp|pdf)$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)')
        && request.resource.metadata.financialSpaceId == spaceId
        && request.resource.metadata.entryId == entryId
        && request.resource.metadata.ownerUid == financialSpace(spaceId).ownerUid
        && request.resource.metadata.entityType == 'financialAttachment';
      allow delete: if canManageFinancialSpace(spaceId);
    }
  }
}
